{
  "name": "nafass-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Collectif Nafass / Nidal Abdo portfolio — React (Vite) front end + Express API",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch-path=server server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js --prod",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "vite": "^8.3.1"
  }
}
